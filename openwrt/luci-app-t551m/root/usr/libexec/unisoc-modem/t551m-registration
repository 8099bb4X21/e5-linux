#!/usr/bin/env python3
"""Cached ModemManager registration; unknown cell IDs remain null."""
import json
import subprocess

try:
    result = subprocess.run(['mmcli', '-J', '-m', 'any', '--timeout=3'],
                            capture_output=True, text=True, timeout=4, check=True)
    modem = json.loads(result.stdout)['modem']
    state = {'idle': 0, 'home': 1, 'searching': 2, 'denied': 3, 'unknown': 4,
             'roaming': 5, 'emergency-only': 8}.get(modem['3gpp']['registration-state'])
    technologies = modem['generic']['access-technologies']
    act = 11 if '5gnr' in technologies else 7 if 'lte' in technologies else None
    print(json.dumps(dict(stat=state, tac=None, cid=None, act=act), separators=(',', ':')))
except (ValueError, KeyError, OSError, subprocess.SubprocessError):
    print('null')

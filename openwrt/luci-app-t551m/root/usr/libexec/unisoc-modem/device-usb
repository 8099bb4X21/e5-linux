#!/bin/sh
case "${1:-}" in
 get) echo '{"ok":1,"role":"device","role_auto":0,"host_supported":0,"net_mode":"ncm","net_scope":"permanent","net_auto":0,"net_available":0}' ;;
 net-list) echo '{"ok":1,"devices":[]}' ;;
 boot|hotplug|host-rescan) exit 0 ;;
 *) echo '{"ok":0,"error":"当前固件仅支持 NCM 设备模式，尚未适配 USB 主机供电及协议切换。"}'; exit 1 ;;
esac

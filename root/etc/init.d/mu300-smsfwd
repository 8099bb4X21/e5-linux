#!/bin/sh /etc/rc.common
# Sidecar SMS forwarding with an own-number whitelist. Installed by the
# mu300-smsfwd package; its postinst stops the built-in forwarding service.
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/mu300-smsfwd/forward run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
